{
  "name": "template-dotnet-spa-react",
  "private": true,
  "description": "AI Masterclass SPA Template",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter 'web-tanstack-start' dev",
    "dev:api": "dotnet watch run --project packages/api/Tsz.Api --launch-profile https",
    "check": "bun run --filter '*' check",
    "typecheck": "bun run --filter '*' typecheck",
    "fallow": "bun run --filter '*' fallow",
    "test:api": "dotnet test packages/api/tests/Tsz.Api.Tests",
    "test:api:int": "dotnet test packages/api/tests/Tsz.Api.Tests.Integration",
    "cleanup": "bun run --filter '*' cleanup",
    "test": "vp test"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "rimraf": "^6.1.3",
    "vite-plus": "^0.1.14"
  },
  "packageManager": "bun@1.3.6",
  "dependencies": {
    "web": "^0.0.2",
    "h3-v2": "npm:h3@2.0.1-rc.20"
  }
}
